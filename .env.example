# Copie para .env e preencha (Windows: copy .env.example .env).
# O .env é lido pelo Next.js, pelo Docker Compose, pelo Drizzle e pelos testes; ele NUNCA vai para o GitHub.
# Nunca coloque valores reais neste arquivo de exemplo.

# Obrigatório (mínimo 32 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Defina POSTGRES_PASSWORD com um segredo local e preencha DATABASE_URL com a mesma senha (escape caracteres de URL).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://solaria:SENHA_AQUI@localhost:5432/solaria
# Obrigatório no ambiente de produção, com certificado TLS confiável.
DATABASE_SSL=false
# Opcional: conteúdo PEM de uma CA privada usada pelo provedor.
DATABASE_SSL_CA=
# Origem pública canônica, sem barra final; HTTPS obrigatório em produção.
APP_URL=http://localhost:3000
# Apenas se o servidor estiver ATRÁS de proxy controlado que reescreva X-Forwarded-For.
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Necessário para o comando db:seed (sem valores fixos no projeto).
SEED_ADMIN_EMAIL=
SEED_ADMIN_NOME=
SEED_ADMIN_SENHA=
FUSO_HORARIO=America/Recife

# Banco SEPARADO para `npm test` (os testes criam e alteram registros). Nunca aponte para produção.
# Atenção: durante os testes o .env.local é ignorado; use o .env ou o .env.test.local.
TEST_DATABASE_URL=postgresql://solaria:SENHA_AQUI@localhost:5432/solaria_test
